# Leave empty to run the demo in replay mode (recorded sample outputs, no API calls).
ANTHROPIC_API_KEY=

# Optional: cap live evaluations per visitor IP per day (default 10).
PA_DAILY_LIMIT_PER_IP=10

# Optional: run the demos on the Java services (healthcare-payer-ai-services project) instead of the built-in
# TypeScript engines. Leave empty to use TypeScript.
PA_ENGINE_URL=
APPEALS_ENGINE_URL=
BENEFITS_ENGINE_URL=
PI_ENGINE_URL=
HCC_ENGINE_URL=

# Code Review Agent: the Python LangGraph service (langgraph-dev-agents repo), e.g. http://localhost:8090.
# Empty means replay only, from data/code-review/results.
CODE_REVIEW_ENGINE_URL=

# Fax Intake Agent: the Python LangGraph + MCP service (payer-ai-agents repo), e.g. http://localhost:8091.
# Empty means replay only, from data/fax-intake/results.
FAX_INTAKE_ENGINE_URL=

# Incident Debugger: the same Python service (langgraph-dev-agents), e.g. http://localhost:8090.
# Empty means replay only, from data/incident/results.
INCIDENT_ENGINE_URL=
